# put the cursor at the bottom of the terminal
# https://github.com/romkatv/powerlevel10k/issues/2442
# https://github.com/romkatv/powerlevel10k/issues/1699

emulate -L zsh

[[ -t 1 ]] || return 0
zmodload zsh/terminfo
# Some terminals (Cursor agent PTY, macOS Terminal) lack civis/cnorm.
(( $+terminfo[civis] )) && echoti civis 2>/dev/null
print -rn -- "${(pl:$((2 * LINES - 1))::\n:)}"
# At shell startup this runs outside ZLE; only refresh when ZLE is active.
if zle; then
    zle -I
    zle -R
fi
print -rn -- ${${terminfo[cnorm]-}:/*$'\e[?25h'(|'\e'*)/$'\e[?25h'}
return 0

